@map/gui_containers "gui containers — all at once"
" gui_list, gui_grid and gui_table on one screen for a quick eyeball.
    gui_reroute_server("show_gui_containers")
    ->END

=== show_gui_containers
    ships = ~~[
        {"name": "Artemis", "hull": 100}, {"name": "Intrepid", "hull": 85},
        {"name": "Raptor",  "hull": 60},  {"name": "Hawk",     "hull": 40},
    ]~~
    cols = ~~[{"key": "name", "label": "Ship"}, {"key": "hull", "label": "Hull", "align": "c", "width": 30}]~~
    tools = ~~["Scan", "Hail", "Target", "Lock", "Fire", "Evade"]~~

    # Left: gui_list (custom rows)
    gui_section("area: 3, 4, 33, 94;")
    with gui_list(ships, select=True, title="$text:gui_list;justify:center;") as ship:
        gui_text("$text:`{ship['name']}`;justify:left;")
        gui_text("$text:`{ship['hull']}%`;justify:right;")

    # Middle: gui_table (declarative columns)
    gui_section("area: 35, 4, 65, 94;")
    gui_table(ships, cols, select=True)

    # Right: gui_grid (fixed grid of buttons)
    gui_section("area: 67, 4, 97, 40;")
    gui_text("$text:gui_grid(2);justify:center;")
    gui_section("area: 67, 42, 97, 94;")
    with gui_grid(2):
        for t in tools:
            gui_button(t)

    await gui()

# The sizzle-reel staging mission (dev-only).
#
# A staging label spawns a scene, binds the cast the shot list names, and loads
# shots.amd; the capture harness then steps the shots one at a time so a still can be
# grabbed while the camera holds.

import maps/sz_stage.mast


# Declared here, filled in by the staging label. A client can connect before the scene
# exists, so the name has to exist first or the client park is a NameError.
default shared SZ_HERO = None


# Route each page to its own label - the standard shape for a mission that does not
# load the LegendaryMissions consoles addon.
#
# Why routing rather than a jump or a scheduled task:
#   * `await gui()` must run on the page's own MAIN GUI TASK; scheduling it puts the
#     await on a task the console is not waiting on.
#   * a bare `jump` at the top level is taken while main is still running, so the
#     SERVER would never reach the rest of the concatenated top level - including the
#     cosmos_devqueue mastlib's own task_schedule, which is the harness's only way to
#     talk to the engine.
# Rerouting sets where each page GOES, without stopping main getting there.
gui_reroute_server("sz_server")
gui_reroute_clients("sz_park")

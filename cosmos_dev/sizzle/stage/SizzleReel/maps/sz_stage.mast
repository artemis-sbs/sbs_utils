# Staging for the sizzle reel.
#
# AMD frames shots; it cannot spawn anything (amd_cutscene.py resolves `Subject:`
# against a cast or a role and DROPS the shot otherwise). So every object a shot
# points at is born here and bound to a cast name.
#
# Determinism is the contract: literal coordinates, explicit facings, ships at rest,
# and no `random` anywhere in this file. A shot list is only worth iterating if take 2
# frames the same thing take 1 did.
#
# Nothing here plays a cutscene. The map parks in a hold loop and the HOST steps the
# shots (cutscene_amd_shots + shot_apply), because a cutscene runs on a clock and a
# clock is useless to something trying to hold a frame still for a screenshot.

# The SERVER's main GUI task, reached by gui_reroute_server. It parks, and nothing
# else: the scene is a real @map, started through the library's own map_start.
=== sz_server ===
    # The sim has to EXIST before anything is spawned into it. A mission that loads the
    # LegendaryMissions consoles addon gets this from LM's own start_server; this one
    # does not, so it does it here - the documented shape for a mission without LM is
    # create_new_sim(), spawn, resume.
    sim_create()

    gui_blank()
    await gui()


# The scene, as an ordinary @map - so the library can start it (maps_find + map_start)
# the same way the server console and the headless runner do, rather than this mission
# inventing a fourth launch sequence.
@map/sz_open "Sizzle: cold open + fight"
    " Stages the hero, the kraliens and a debris field for the capture harness.
    # --- the cast -----------------------------------------------------------------
    shared SZ_HERO = to_object(npc_spawn(0, 0, 0, "Artemis", "tsn", "tsn_light_cruiser", "behav_npcship"))
    shared SZ_LEAD = to_object(npc_spawn(2400, 0, 1800, "Kralien Lead", "kralien", "kralien_battleship", "behav_npcship"))
    shared SZ_WING = to_object(npc_spawn(3200, 0, 2600, "Kralien Two", "kralien", "kralien_cruiser", "behav_npcship"))
    shared SZ_FIGHTER = to_object(npc_spawn(300, 0, 0 - 400, "Hawk 1", "tsn", "tsn_fighter", "behav_npcship"))

    # Something for the wide shots to have depth against. Fixed positions, no random.
    for sz_i in range(9):
        terrain_spawn(0 - 8000 + sz_i * 1900, 0, 5200, f"szrock{sz_i}", "#,szref", "plain_asteroid_9", "behav_asteroid")

    cutscene_cast("hero", SZ_HERO)
    cutscene_cast("raider_lead", SZ_LEAD)
    cutscene_cast("fighter", SZ_FIGHTER)

    # A 2D console screen is not a space object and has no cast entry of its own. The
    # shot points at the hero so the record resolves; the PICTURE comes from rerouting
    # a client to that screen and capturing its window instead of the camera's.
    cutscene_cast("engineering_screen", SZ_HERO)

    # --- the shot list ------------------------------------------------------------
    # amd_document takes the TEXT, not a path.
    sz_doc = amd_document(media_read_relative_file("shots.amd"))
    sz_loaded = amd_cutscenes(amd_root_node(sz_doc))

    signal_emit("sz_staged")
    ->END


# The firefight is SCRIPTED, not simulated. Letting brains fight and hoping a good
# frame happens is how a contact sheet comes back full of empty space.
//signal/sz_fire
    ->END if not object_exists(SZ_LEAD.id)
    target(SZ_LEAD.id, SZ_HERO.id, True, 0.0)
    target(SZ_WING.id, SZ_HERO.id, True, 0.0)
    ->END


# A CLIENT's main GUI task, reached by gui_reroute_clients.
=== sz_park ===
    # The scene may not exist yet; a client can connect before the staging label has
    # run. Poll rather than await a signal - a signal emitted before this task existed
    # is simply missed, and the console would sit blank forever waiting for it.
--- sz_wait
    if SZ_HERO is None:
        await delay_sim(0.5)
        jump sz_wait

    # Both are needed: the engine renders what a console is ASSIGNED to, and the view
    # mode decides how it is drawn. shot_apply redoes both per shot (camera_track
    # assigns and calls gui_cinematic_full_control), so this is only what to look at
    # until the first shot lands.
    assign_client_to_ship(client_id, SZ_HERO.id)
    gui_cinematic_auto(client_id)

    # The 3D view is an ENGINE widget and only renders when the console's widget list
    # contains it - assigning a ship and setting the view mode is not enough on its own.
    # Without this the page is a bare `await gui()`, which is a black screen with the
    # overlays drawn on top: the lower third appears and the shot does not, which reads
    # as "the camera is pointing at nothing" when the camera is fine.
    #
    # Full bleed, its own section, no MAST controls beside it - the engine draws an
    # engine widget at its own size and paints over anything sharing the row.
    gui_section(style="area:0,0,100,100;")
    gui_row()
    gui_layout_widget("3dview")
    await gui()

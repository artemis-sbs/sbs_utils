# Visual demos of the sbs_utils GUI containers, runnable IN ENGINE:
#   load the "SBS Utils" mission -> "GUI Containers" button (script.py GuiMain).
# Conformance is covered headless by sbs_utils/tests (test_gui_list.py, ...).

->menu

================= menu =================
gui_section("area: 28, 22, 72, 80;")
gui_text("$text:sbs_utils GUI Containers;justify:center;font:gui-2;")
gui_text("$text:Pick a container to see it render.;justify:center;color:#aaa;")
await gui():
    + "gui_list  (custom rows)":
        -> demo_list
    + "gui_grid  (button palette)":
        -> demo_grid
    + "gui_table  (declarative)":
        -> demo_table
    + "all at once":
        -> demo_all

================= demo_list =================
ships = ~~[
    {"name": "Artemis",         "hull": 100, "side": "tsn"},
    {"name": "Intrepid",        "hull": 85,  "side": "tsn"},
    {"name": "Raptor Longname", "hull": 60,  "side": "raider"},
    {"name": "Hawk",            "hull": 40,  "side": "raider"},
    {"name": "Gadfly",          "hull": 95,  "side": "kralien"},
    {"name": "Wisp",            "hull": 70,  "side": "arvon"},
]~~
gui_section("area: 5, 5, 60, 88;")
with gui_list(ships, select=True, title="$text:Fleet;justify:center;") as ship:
    gui_text("$text:`{ship['name']}`;justify:left;")
    gui_text("$text:`{ship['side']}`;justify:center;color:#8cf;")
    gui_text("$text:`{ship['hull']}%`;justify:right;")
gui_section("area: 65, 5, 95, 88;")
gui_text("$text:gui_list - the row (name / side / hull) is authored in MAST and repeats per ship. Selecting a row highlights it.;")
await gui():
    + "back":
        -> menu

================= demo_grid =================
tools = ~~["Scan", "Hail", "Target", "Lock", "Fire", "Evade", "Dock", "Warp"]~~
gui_section("area: 5, 5, 95, 20;")
gui_text("$text:gui_grid(4) - items flow into even rows of 4.;justify:center;")
gui_section("area: 20, 22, 80, 88;")
with gui_grid(4):
    for t in tools:
        gui_button(t)
await gui():
    + "back":
        -> menu

================= demo_table =================
fleet = ~~[
    {"name": "Artemis",  "hull": 100, "active": True,  "mode": "patrol"},
    {"name": "Intrepid", "hull": 85,  "active": False, "mode": "escort"},
    {"name": "Raptor",   "hull": 60,  "active": True,  "mode": "hold"},
]~~
cols = ~~[
    {"key": "name",   "label": "Ship",   "align": "l"},
    {"key": "hull",   "label": "Hull",   "align": "c", "width": 12},
    {"key": "active", "label": "Active", "type": "checkbox", "width": 14},
    {"key": "mode",   "label": "Mode",   "type": "dropdown", "options": ["patrol", "escort", "hold"], "width": 26},
    {"key": "go",     "label": "",       "type": "button", "button_label": "Launch", "width": 18},
]~~
gui_section("area: 5, 5, 95, 88;")
gui_table(fleet, cols, select=True)
await gui():
    + "back":
        -> menu

================= demo_all =================
ships = ~~[
    {"name": "Artemis", "hull": 100}, {"name": "Intrepid", "hull": 85},
    {"name": "Raptor",  "hull": 60},  {"name": "Hawk",     "hull": 40},
]~~
cols = ~~[{"key": "name", "label": "Ship"}, {"key": "hull", "label": "Hull", "align": "c", "width": 30}]~~
btns = ~~["Scan", "Hail", "Target", "Lock", "Fire", "Evade"]~~
gui_section("area: 3, 4, 33, 88;")
with gui_list(ships, select=True, title="$text:gui_list;justify:center;") as ship:
    gui_text("$text:`{ship['name']}`;justify:left;")
    gui_text("$text:`{ship['hull']}%`;justify:right;")
gui_section("area: 35, 4, 65, 88;")
gui_table(ships, cols, select=True)
gui_section("area: 67, 4, 97, 20;")
gui_text("$text:gui_grid(2);justify:center;")
gui_section("area: 67, 22, 97, 88;")
with gui_grid(2):
    for b in btns:
        gui_button(b)
await gui():
    + "back":
        -> menu

<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <style>
@@STYLE@@
  </style>
</helmet>
<div class="dev {{ armedClass }}">

  <div class="who">
    <span class="name">Ume Mbeki</span>
    <span class="job">comms</span>
    <span class="at">{{ at }}</span>
  </div>

  <div class="app">

    <!-- HOME: what is happening, then the tools. Nothing is pinned below it. -->
    <sc-if value="{{ home }}" hint-placeholder-val="{{ true }}">
      <div class="app-head">
        <h2>xESS</h2>
        <div class="rule"></div>
      </div>

      <div class="say">
        <p>{{ line }}</p>
      </div>

      <div class="tiles">
        <sc-for list="{{ tiles }}" as="t" hint-placeholder-count="5">
          <button class="tile" onClick="{{ t.open }}">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="{{ t.tint }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="{{ t.path }}"></path>
            </svg>
            <span class="lbl">
              <h3>{{ t.name }}</h3>
              <p>{{ t.blurb }}</p>
            </span>
            <span class="badge {{ t.hot }}">{{ t.badge }}</span>
          </button>
        </sc-for>
      </div>
    </sc-if>

    <!-- ACT: the beat, then ONE BUTTON PER CHOICE. Pressed once, no selection step. -->
    <sc-if value="{{ isAct }}" hint-placeholder-val="{{ false }}">
      <div class="app-head">
        <h2>Act</h2>
        <div class="rule"></div>
        <button class="back" onClick="{{ close }}">BACK</button>
      </div>
      <div class="beat">
        <p>{{ line }}</p>
      </div>
      <div class="picks">
        <sc-for list="{{ picks }}" as="p" hint-placeholder-count="3">
          <button class="pick" onClick="{{ p.take }}">
            {{ p.label }}
            <span class="for">{{ p.note }}</span>
          </button>
        </sc-for>
      </div>
    </sc-if>

    <!-- CREW: everyone you can reach, what each last said, and the way home.
         HAIL and PARTY merged - an audience picker and a roster were the same list. -->
    <sc-if value="{{ isCrew }}" hint-placeholder-val="{{ false }}">
      <div class="app-head">
        <h2>Crew</h2>
        <div class="rule"></div>
        <button class="back" onClick="{{ close }}">BACK</button>
      </div>
      <div class="site">{{ siteLine }}</div>
      <div class="callers">
        <sc-for list="{{ callers }}" as="c" hint-placeholder-count="4">
          <div class="caller {{ c.kind }}">
            <div class="top">
              <span class="n">{{ c.name }}</span>
              <span class="j">{{ c.job }}</span>
              <span class="cnt {{ c.mine }}">{{ c.count }}</span>
            </div>
            <div class="r">{{ c.room }}</div>
            <p class="said {{ c.quiet }}">{{ c.said }} <span class="ago">{{ c.ago }}</span></p>
            <div class="acts2">
              <sc-for list="{{ c.acts }}" as="a" hint-placeholder-count="2">
                <button class="{{ a.kind }}" onClick="{{ a.go }}">{{ a.label }}</button>
              </sc-for>
            </div>
          </div>
        </sc-for>
      </div>
      <div class="more">{{ moreText }}</div>
    </sc-if>

    <!-- SCAN: a handful of lines and a sentence. Length lives on the ePADD. -->
    <sc-if value="{{ isSheet }}" hint-placeholder-val="{{ false }}">
      <div class="app-head">
        <h2>{{ sheetName }}</h2>
        <div class="rule"></div>
        <button class="back" onClick="{{ close }}">BACK</button>
      </div>
      <div class="read">
        <sc-for list="{{ readout }}" as="r" hint-placeholder-count="4">
          <div class="line"><span class="k">{{ r.k }}</span><span class="v {{ r.tone }}">{{ r.v }}</span></div>
        </sc-for>
      </div>
      <div class="say">
        <p class="quiet">{{ sheetNote }}</p>
      </div>
    </sc-if>

    <!-- FIRE: arm, pick a setting, then click the map. Armed reaches the bar above. -->
    <sc-if value="{{ isFire }}" hint-placeholder-val="{{ false }}">
      <div class="app-head">
        <h2>Fire</h2>
        <div class="rule"></div>
        <button class="back" onClick="{{ close }}">BACK</button>
      </div>
      <div class="arm">
        <div class="state {{ armedClass }}">{{ armedText }}</div>
        <div class="setting">
          <sc-for list="{{ settings }}" as="s" hint-placeholder-count="3">
            <button class="{{ s.cls }}" onClick="{{ s.go }}">{{ s.name }}</button>
          </sc-for>
        </div>
        <p class="effect">{{ effect }}</p>
        <div class="read">
          <div class="line"><span class="k">Range</span><span class="v">6 cells</span></div>
          <div class="line"><span class="k">In reach</span><span class="v">hatch mechanism</span></div>
          <div class="line"><span class="k">Also in reach</span><span class="v hurt">Marek Sol</span></div>
        </div>
      </div>
      <p class="warnline">{{ warn }}</p>
      <div class="spacer"></div>
      <button class="go" onClick="{{ toggleArm }}">{{ armButton }}</button>
    </sc-if>

  </div>
</div>
</x-dc>
<script data-dc-script data-props='{"$preview":{"width":640,"height":1080}}'>
class Component extends DCLogic {
  constructor(props) {
    super(props);
    // `open` is which app is up; null is the tile sheet. A real beat OPENS act by
    // itself - that is modelled here by starting on the tiles with the badge lit,
    // so both halves of the decision are visible on one artboard.
    // `sent` is how many lines this console has sent back. It is here so pressing a
    // send button visibly becomes the newest thing in HAIL - the app reads the inbox,
    // it does not keep a separate outbox.
    this.state = { open: null, beat: 'hatch', armed: false, setting: 'stun',
                   sent: 0, readAt: 0 };
  }

  // Newest first, the way `message_inbox(console)` returns it.
  inbox() {
    const base = [
      { from: 'Artemis', subject: 'Ultra-Beam', when: '40 s ago',
        text: 'We have you at two. Say again on the hatch - was it forced?' },
      { from: 'Marek Sol', subject: 'Party', when: '3 min ago',
        text: 'Reactor gallery is warm. Warmer than the corridor by twenty degrees.' },
      { from: 'Artemis', subject: 'Ultra-Beam', when: '6 min ago',
        text: 'Transporter lock is good. Four seats, three of you down.' },
    ];
    const mine = [];
    for (let i = 0; i < this.state.sent; i += 1) {
      mine.push({ from: 'You', subject: 'Sent', when: 'just now',
                  text: 'Standing by. Nothing has changed down here.' });
    }
    return mine.concat(base);
  }

  beats() {
    return {
      hatch: {
        at: 'Entry Corridor',
        line: 'Your breath is visible. A body lies half through the inner hatch, and the hatch was opened from the inside.',
        picks: [
          { label: 'Kneel by the body at the hatch', note: '', go: 'body' },
          { label: 'Read the corridor thermals', note: 'covering for Chief Ruiz', go: 'cold' },
          { label: 'Move further in', note: '', go: 'lab' },
        ],
      },
      body: {
        at: 'Entry Corridor',
        line: 'Station coveralls, no insignia, and no sign of a struggle. Whoever this was, they were leaving.',
        picks: [
          { label: 'Take a scan for the survey log', note: '', go: 'cold' },
          { label: 'Leave them and move further in', note: '', go: 'lab' },
        ],
      },
      cold: {
        at: 'Entry Corridor',
        line: 'The corridor has been at four degrees for eleven days. Nothing here died of the cold.',
        picks: [
          { label: 'Move further in', note: '', go: 'lab' },
        ],
      },
      lab: {
        at: 'Sample Lab',
        line: 'Containment on bench three has failed. The gel is cold and the seal was opened from the inside.',
        picks: [
          { label: 'Examine the containment gel', note: '', go: 'lab' },
          { label: 'Read the sample manifest', note: '', go: 'lab' },
          { label: 'Go down to the reactor gallery', note: '', go: 'hatch' },
        ],
      },
    };
  }

  renderVals() {
    const beats = this.beats();
    const beat = beats[this.state.beat] || beats.hatch;
    const open = this.state.open;
    const armed = this.state.armed;

    const mk = (id, name, blurb, path, badge, hot) => ({
      id, name, blurb, path, badge: badge || '', hot: hot ? 'hot' : '',
      tint: id === 'fire' ? '#9ab' : '#8cf',
      // Opening CREW marks the inbox read, the way `message_mark_read` does - so the
      // badge is cleared by the act of looking, not by a second gesture.
      open: () => this.setState(
        id === 'crew' ? { open: id, readAt: this.inbox().length } : { open: id }),
    });

    const mail = this.inbox();
    // Unread is the tile's badge, exactly as `message_unread(console)` feeds the
    // PADD's.
    const unread = Math.max(0, mail.length - this.state.readAt);

    const tiles = [
      mk('crew', 'CREW', 'Artemis, and 2 down here',
         'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 20a6 6 0 0 1 12 0M17 11a3 3 0 1 0 0-6M16 20h5a5 5 0 0 0-4-4.9',
         unread ? unread + ' new' : ''),
      mk('scan', 'SCAN', 'Read the room you are in',
         'M12 3v3M12 18v3M3 12h3M18 12h3M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z', ''),
      mk('act', 'ACT', 'What you can do here',
         'M5 12l5 5L19 7', beat.picks.length + ' here', true),
      mk('fire', 'FIRE', 'Arm, then click the map',
         'M5 14h9l5-4-5-4H5zM5 14v6', armed ? 'ARMED' : '', armed),
    ];

    const sheets = {
      scan: {
        name: 'Scan',
        note: 'Filed to the survey log. The ePADD holds every reading the party has taken.',
        rows: [
          { k: 'Room', v: beat.at, tone: '' },
          { k: 'Condition', v: 'damaged', tone: 'hurt' },
          { k: 'Temperature', v: '4 C', tone: 'hurt' },
          { k: 'Atmosphere', v: 'breathable', tone: 'ok' },
          { k: 'Lifesigns', v: '1 - you', tone: '' },
        ],
      },
    };
    const sheet = sheets[open] || null;

    // The roster IS the inbox, grouped by who said it. Each row's last line is simply
    // the newest message whose `from` is that name - free, because every message
    // already carries one.
    const say = () => this.setState({ sent: this.state.sent + 1,
                                      readAt: this.inbox().length + 1 });
    const newestFrom = (name) => mail.find((m) => m.from === name) || null;
    const seenAfter = mail.length - unread;
    const row = (name, job, room, kind, acts) => {
      const m = newestFrom(name);
      const fresh = m ? mail.indexOf(m) < unread : false;
      return {
        name, job, room: room || '', kind: kind || '',
        said: m ? m.text : 'Nothing said yet.',
        quiet: m ? '' : 'quiet',
        ago: m ? m.when.replace(' ago', '') : '',
        count: kind === 'you' ? '(you)' : (fresh ? 'new' : ''),
        mine: kind === 'you' ? 'me' : '',
        acts: acts || [],
      };
    };

    const callers = [
      // THE SHIP IS A ROW, and it is the row that carries BEAM UP.
      row('Artemis', 'ship', '', 'ship', [
        { label: 'REPORT IN', kind: '', go: say },
        { label: 'BEAM UP', kind: 'home', go: () => {} },
      ]),
      row('Ume Mbeki', 'comms', beat.at, 'you', []),
      row('Marek Sol', 'engineer', 'Reactor Gallery', '', [
        { label: 'CALL MAREK', kind: '', go: say },
      ]),
      row('Ana Ruiz', 'chief', 'Entry Corridor', '', [
        { label: 'CALL ANA', kind: '', go: say },
      ]),
      row('Everyone', 'all channels', '', '', [
        { label: 'CALL FOR HELP', kind: '', go: say },
      ]),
    ];

    return {
      at: armed ? 'ARMED - ' + this.state.setting.toUpperCase() : beat.at,
      line: beat.line,
      tiles,
      home: !open,
      isAct: open === 'act',
      isCrew: open === 'crew',
      isSheet: !!sheet,
      isFire: open === 'fire',
      picks: beat.picks.map((p) => ({
        label: p.label,
        note: p.note ? '(' + p.note + ')' : '',
        take: () => this.setState({ beat: p.go, open: null }),
      })),
      siteLine: 'Erebus Outpost - 3 of 4 down',
      callers,
      moreText: seenAfter > 1 ? (seenAfter - 1) + ' older on the ePADD'
                              : 'Nothing older waiting',
      sheetName: sheet ? sheet.name : '',
      sheetNote: sheet ? sheet.note : '',
      readout: sheet ? sheet.rows : [],
      armedClass: armed ? 'live' : '',
      armedText: armed ? 'ARMED - ' + this.state.setting.toUpperCase() : 'SAFE',
      armButton: armed ? 'MAKE SAFE' : 'ARM',
      warn: armed ? 'The next click on the map is a shot. One shot, then safe.' : '',
      settings: [
        { key: 'stun', name: 'STUN' },
        { key: 'cut', name: 'CUT' },
        { key: 'full', name: 'FULL' },
      ].map((s) => ({
        name: s.name,
        cls: (s.key === 'full' ? 'full ' : '') + (this.state.setting === s.key ? 'on' : ''),
        go: () => this.setState({ setting: s.key }),
      })),
      effect: {
        stun: 'Stops a person. Does nothing at all to a door, a panel or a bulkhead.',
        cut: 'Opens a thing - a hatch, a weld, a lock. Lethal to a person, because a cutting beam is.',
        full: 'Destroys what it hits, whatever that is. The only setting that is a weapon and nothing else.',
      }[this.state.setting],
      toggleArm: () => this.setState({ armed: !armed }),
      close: () => this.setState({ open: null }),
    };
  }
}
</script>
</body>
</html>

<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <style>
@@STYLE@@
  </style>
</helmet>
<!-- CREW - HAIL and PARTY were the same app.
     The roster IS the inbox, grouped by who said it: messages already carry `from`,
     so each row shows where somebody is AND the last thing they said. The ship is a
     row like anyone else, and it is the row that carries BEAM UP, because the ship is
     what beams you up.

     THE LIST IS A gui_list_box with an item_template, not a stack of rows - it is the
     one scrolling band in this app, and a fixed row inside a fixed region is never
     scaled down, so past what fits it would spill over the map. -->
<div class="dev">

  <div class="who">
    <span class="name">Ume Mbeki</span>
    <span class="job">comms</span>
    <span class="at">Sample Lab</span>
  </div>

  <div class="app">
    <div class="app-head">
      <h2>Crew</h2>
      <div class="rule"></div>
      <button class="back">BACK</button>
    </div>

    <div class="site">Erebus Outpost &mdash; 3 of 4 down</div>

    <div class="callers">

      <div class="caller ship">
        <div class="top">
          <span class="n">Artemis</span>
          <span class="j">ship</span>
          <span class="cnt">2 new</span>
        </div>
        <p class="said">We have you at two. Say again on the hatch &mdash; was it
        forced? <span class="ago">40 s</span></p>
        <div class="acts2">
          <button>REPORT IN</button>
          <button class="home">BEAM UP</button>
        </div>
      </div>

      <div class="caller you">
        <div class="top">
          <span class="n">Ume Mbeki</span>
          <span class="j">comms</span>
          <span class="cnt me">(you)</span>
        </div>
        <div class="r">Sample Lab</div>
      </div>

      <div class="caller">
        <div class="top">
          <span class="n">Marek Sol</span>
          <span class="j">engineer</span>
          <span class="cnt">1 new</span>
        </div>
        <div class="r">Reactor Gallery</div>
        <p class="said">Warmer than the corridor by twenty degrees.
        <span class="ago">3 min</span></p>
        <div class="acts2">
          <button>CALL MAREK</button>
        </div>
      </div>

      <div class="caller">
        <div class="top">
          <span class="n">Ana Ruiz</span>
          <span class="j">chief</span>
        </div>
        <div class="r">Entry Corridor</div>
        <p class="said quiet">Nothing said yet.</p>
        <div class="acts2">
          <button>CALL ANA</button>
        </div>
      </div>

      <div class="caller">
        <div class="top">
          <span class="n">Everyone</span>
          <span class="j">all channels</span>
        </div>
        <div class="acts2">
          <button>CALL FOR HELP</button>
        </div>
      </div>

    </div>

    <div class="more">3 older on the ePADD</div>
  </div>

</div>
</x-dc>
</body>
</html>

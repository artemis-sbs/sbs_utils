<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <style>
@@STYLE@@
    /* --- an app, once opened: PADD chrome above, the tab's own screen below -- */
    .app-bar { height: 64px; flex: 0 0 auto; display: flex; align-items: center; gap: 28px;
               padding: 0 40px; background: var(--panel-head);
               border-bottom: 1px solid var(--hair); }
    .home-btn { display: flex; align-items: center; gap: 12px; background: var(--strip-back);
                color: #000; border: none; font-family: var(--display); font-weight: 700;
                font-size: 22px; letter-spacing: .10em; padding: 8px 20px; cursor: pointer; }
    .home-btn:hover { background: #bbb; }
    .app-title { font-family: var(--display); font-weight: 700; font-size: 32px;
                 letter-spacing: .04em; }
    .app-sub { font-size: 22px; color: var(--dim); }
    .app-body { flex: 1 1 auto; margin: 40px 96px 60px 96px;
                border: 2px dashed rgba(136,204,255,.30);
                display: flex; flex-direction: column; align-items: center;
                justify-content: center; gap: 14px; text-align: center; }
    .app-body .h { font-family: var(--display); font-weight: 700; font-size: 28px;
                   letter-spacing: .14em; color: var(--accent); }
    .app-body .d { font-size: 24px; color: var(--dim); max-width: 900px; line-height: 1.35; }
    .app-body code { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 22px;
                     color: var(--text); background: rgba(17,85,119,.35); padding: 2px 8px; }
  </style>
</helmet>

<div style="position: relative; width: 1920px; height: 1080px;">

  <!-- Engine tab strip. Six even slots, blanks padded in front, the console back
       tab last (rightmost, #999) - exactly what gui_queue_console_tabs emits. -->
  <div class="strip">
    <div class="slot"></div>
    <div class="slot"></div>
    <div class="slot"></div>
    <div class="slot"></div>
    <div class="slot"><div class="tab">ePADD</div></div>
    <div class="slot"><div class="tab back">{{station}}</div></div>
  </div>

  <sc-if value="{{isHome}}" hint-placeholder-val="{{ true }}">
    <div class="padd">
      <div class="padd-bar">
        <div class="mark">e<em>PADD</em></div>
        <div class="bar-dim">TSN Artemis</div>
        <div class="bar-right">
          <div class="bar-dim">{{stationLabel}}</div>
          <div class="bar-dim">14:32</div>
          <div class="pill">CONDITION GREEN</div>
        </div>
      </div>

      <div class="sheet">

        <sc-if value="{{show.shipGroup}}" hint-placeholder-val="{{ true }}">
          <div>
            <div class="group-head"><h2>Ship</h2><div class="rule"></div></div>
            <div class="grid" style="margin-top: 22px;">

              <sc-if value="{{show.cargo}}" hint-placeholder-val="{{ true }}">
                <button class="tile" onClick="{{openCargo}}">
                  <img class="ico" src="epadd-cargo.png" alt="">
                  <span class="lbl"><h3>Cargo</h3><p>Hold manifest, transfer, jettison</p></span>
                </button>
              </sc-if>

              <sc-if value="{{show.fabricate}}" hint-placeholder-val="{{ true }}">
                <button class="tile" onClick="{{openFabricate}}">
                  <img class="ico" src="epadd-fabricate.png" alt="">
                  <span class="lbl"><h3>Fabricate</h3><p>Beacons, parts, build queue</p></span>
                </button>
              </sc-if>

              <sc-if value="{{show.upgrades}}" hint-placeholder-val="{{ true }}">
                <button class="tile" onClick="{{openUpgrades}}">
                  <img class="ico" src="epadd-upgrades.png" alt="">
                  <span class="lbl"><h3>Upgrades</h3><p>Installed and available refits</p></span>
                </button>
              </sc-if>

              <sc-if value="{{show.airwing}}" hint-placeholder-val="{{ false }}">
                <button class="tile" onClick="{{openAirwing}}">
                  <img class="ico" src="epadd-airwing.png" alt="">
                  <span class="lbl"><h3>Airwing</h3><p>Craft, pilots, sortie board</p></span>
                </button>
              </sc-if>

              <sc-if value="{{show.casino}}" hint-placeholder-val="{{ false }}">
                <button class="tile" onClick="{{openCasino}}">
                  <img class="ico" src="epadd-casino.png" alt="">
                  <span class="lbl"><h3>Casino</h3><p>Table games and the bar tab</p></span>
                </button>
              </sc-if>

            </div>
          </div>
        </sc-if>

        <div>
          <div class="group-head"><h2>Mission</h2><div class="rule"></div></div>
          <div class="grid" style="margin-top: 22px;">

            <button class="tile" onClick="{{openQuests}}">
              <img class="ico" src="epadd-quests.png" alt="">
              <span class="lbl"><h3>Quests</h3><p>Jobs offered, taken and running</p></span>
            </button>

            <button class="tile" onClick="{{openLibrary}}">
              <img class="ico" src="epadd-library.png" alt="">
              <span class="lbl"><h3>Library</h3><p>Codex, lore and ship records</p></span>
            </button>

            <button class="tile" onClick="{{openHelp}}">
              <img class="ico" src="epadd-help.png" alt="">
              <span class="lbl"><h3>Help</h3><p>How this console works</p></span>
            </button>

          </div>
        </div>

        <sc-if value="{{show.devGroup}}" hint-placeholder-val="{{ false }}">
          <div>
            <div class="group-head"><h2>Systems</h2><div class="rule"></div></div>
            <div class="grid" style="margin-top: 22px;">
              <button class="tile" onClick="{{openDebug}}">
                <img class="ico" src="epadd-debug.png" alt="">
                <span class="lbl"><h3>Debug</h3><p>Dev build only</p></span>
              </button>
              <button class="tile" onClick="{{openBrain}}">
                <img class="ico" src="epadd-brain.png" alt="">
                <span class="lbl"><h3>Brain scan</h3><p>Dev build only</p></span>
              </button>
            </div>
          </div>
        </sc-if>

      </div>

      <div class="exit">
        <button onClick="{{noop}}">RETURN TO {{stationUpper}}</button>
      </div>
    </div>
  </sc-if>

  <sc-if value="{{isOpen}}" hint-placeholder-val="{{ false }}">
    <div class="padd">
      <div class="app-bar">
        <button class="home-btn" onClick="{{goHome}}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11l8-7 8 7"></path><path d="M6.5 9.5V20h11V9.5"></path></svg>
          HOME
        </button>
        <div class="app-title">{{openTitle}}</div>
        <div class="app-sub">{{openSub}}</div>
        <div class="bar-right">
          <div class="bar-dim">{{stationLabel}}</div>
          <div class="bar-dim">14:32</div>
          <div class="pill">CONDITION GREEN</div>
        </div>
      </div>
      <div class="app-body">
        <div class="h">THE APP&#39;S OWN SCREEN, UNCHANGED</div>
        <div class="d">ePADD supplies the bar above and nothing below it. Opening an app
          jumps the GUI task to its existing <code>//gui/tab/{{openTab}}</code> label, so
          every panel that is a tab today renders here exactly as it does now.</div>
      </div>
    </div>
  </sc-if>

</div>
</x-dc>

<script data-dc-script data-props='{
  "station": {"editor": "enum", "options": ["helm", "weapons", "engineering", "science", "comms", "hangar"], "default": "engineering", "section": "Scope"},
  "devBuild": {"editor": "boolean", "default": false, "section": "Scope"},
  "$preview": {"width": 1920, "height": 1080}
}'>
class Component extends DCLogic {
  // Which apps each station registers. This is the whole point of the design:
  // one strip button, and the grid behind it differs per console.
  apps() {
    const s = this.props.station ?? 'engineering';
    const dev = !!this.props.devBuild;
    const by = {
      helm: [],
      weapons: [],
      science: [],
      comms: [],
      engineering: ['cargo', 'fabricate', 'upgrades'],
      hangar: ['airwing', 'casino', 'cargo'],
    };
    const ship = by[s] ?? [];
    return {
      cargo: ship.includes('cargo'),
      fabricate: ship.includes('fabricate'),
      upgrades: s === 'engineering',
      airwing: ship.includes('airwing'),
      casino: ship.includes('casino'),
      shipGroup: ship.length > 0,
      devGroup: dev,
    };
  }

  open(tab, title, sub) {
    return () => this.setState({ open: { tab, title, sub } });
  }

  renderVals() {
    const s = this.props.station ?? 'engineering';
    const open = this.state && this.state.open;
    return {
      station: s,
      stationLabel: s.toUpperCase(),
      stationUpper: s.toUpperCase(),
      show: this.apps(),
      isHome: !open,
      isOpen: !!open,
      openTab: open ? open.tab : '',
      openTitle: open ? open.title : '',
      openSub: open ? open.sub : '',
      goHome: () => this.setState({ open: null }),
      noop: () => {},
      openCargo: this.open('cargo', 'Cargo', 'Hold manifest'),
      openFabricate: this.open('fabricate', 'Fabricate', 'Build queue'),
      openUpgrades: this.open('upgrade', 'Upgrades', 'Refits'),
      openAirwing: this.open('airwing', 'Airwing', 'Sortie board'),
      openCasino: this.open('casino', 'Casino', 'Tables'),
      openQuests: this.open('quest', 'Quests', 'Jobs and objectives'),
      openLibrary: this.open('library', 'Library', 'Codex'),
      openHelp: this.open('help', 'Help', 'Console reference'),
      openDebug: this.open('debug', 'Debug', 'Dev build'),
      openBrain: this.open('brain', 'Brain scan', 'Dev build'),
    };
  }
}
</script>
</body>
</html>
